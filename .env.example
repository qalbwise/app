# Web (build-time)
VITE_API_URL="http://localhost:8000"
VITE_GOOGLE_CLIENT_ID="your-google-client-id" # same as GOOGLE_CLIENT_ID, but for client-side use

# Postgres
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="mydb"

# API / Worker
SECRET_KEY="change-me-to-a-long-random-string"
DATABASE_URL="postgresql+asyncpg://user:password@db:5432/mydb"
REDIS_URL="redis://redis:6379/0"
OPENAI_API_KEY="sk-xxx"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
GOOGLE_CLIENT_ID="your-google-client-id" # same as VITE_GOOGLE_CLIENT_ID, but for server-side use
