# ─── Web (build-time) ─────────────────────────────────────────────────────────
VITE_API_URL="http://localhost:8000"
VITE_GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"
VITE_QF_CLIENT_ID="your-qf-client-id"

# ─── Postgres ────
POSTGRES_USER="user"
POSTGRES_PASSWORD="password"
POSTGRES_DB="qalbwise"

# ─── API / Worker ─────────────────────────────────────────────────────────────
SECRET_KEY="change-me-in-production"
DATABASE_URL="postgresql+asyncpg://user:password@db:5432/qalbwise"
REDIS_URL="redis://redis:6379/0"

OPENAI_API_KEY="sk-xxx"
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
GOOGLE_CLIENT_ID="xxx.apps.googleusercontent.com"

# ─── Quran Foundation OAuth2 ──────────────────────────────────────────────────
QF_CLIENT_ID="your-qf-client-id"
QF_CLIENT_SECRET="your-qf-client-secret"
QF_AUTH_BASE_URL="https://prelive-oauth2.quran.foundation"
QF_API_BASE_URL="https://apis-prelive.quran.foundation"
QF_REDIRECT_URI="http://localhost:8000/auth/qf/callback"
QF_MUSHAF_ID=4
FRONTEND_URL="http://localhost:3000"
