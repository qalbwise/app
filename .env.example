# Web (build-time; copy to apps/web/.env for Vite)
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# API / Worker
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/mydb
REDIS_URL=redis://redis:6379/0

# LLM: OpenRouter (optional) — sk-or-v1-... or use OPENAI_API_KEY
OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENAI_API_KEY=sk-or-v1-xxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Qalbwise

GOOGLE_CLIENT_ID=your-google-client-id
