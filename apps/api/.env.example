# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb

# API / Worker
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://user:password@db:5432/mydb
REDIS_URL=redis://redis:6379/0

# LLM: OpenRouter (default) — use sk-or-v1-... in OPENROUTER_API_KEY or OPENAI_API_KEY
OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENAI_API_KEY=sk-or-v1-xxx
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Optional OpenRouter attribution:
# OPENROUTER_HTTP_REFERER=https://your-site.example
# OPENROUTER_APP_TITLE=Qalbwise

# Google Sign-In (must match the OAuth client used by the web app)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: extra browser origins for CORS (comma-separated), e.g. https://preview.example.com
# CORS_EXTRA_ORIGINS=

# Frontend env vars live in apps/web/.env — e.g. VITE_API_URL, VITE_GOOGLE_CLIENT_ID
